{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ekuodpaaiugzywfcmjeo.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "nazai-mcp",
      "version": "0.1.0",
      "title": "NazAI"
    },
    "tools": [
      {
        "name": "list_agents",
        "title": "List NazAI agents",
        "description": "List all NazAI AI agents owned by the signed-in user, including id, name, role, goal, status, autonomy, and schedule.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max agents to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_agent",
        "title": "Get NazAI agent",
        "description": "Get the full manifest for a specific NazAI agent (system prompt, tools, triggers, guardrails, KPIs, UI spec).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string",
              "format": "uuid",
              "description": "The agent's UUID (from list_agents)."
            }
          },
          "required": [
            "agent_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_agent_events",
        "title": "List agent events",
        "description": "List the most recent runtime events (reasoning, tool_call, tool_result, action, finished, error) for a NazAI agent.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string",
              "format": "uuid",
              "description": "The agent's UUID."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Max events (default 50)."
            }
          },
          "required": [
            "agent_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_projects",
        "title": "List NazAI projects",
        "description": "List the signed-in user's NazAI projects (generated websites and missions).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max projects (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "run_agent",
        "title": "Run NazAI agent now",
        "description": "Manually trigger a run of a NazAI agent against its connected business tools. Returns the run summary.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string",
              "format": "uuid",
              "description": "The agent's UUID."
            }
          },
          "required": [
            "agent_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
